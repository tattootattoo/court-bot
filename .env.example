# انسخ هذا الملف باسم .env وعدّل القيم. كل ما عدا BOT_TOKEN اختياري.

# توكن البوت من @BotFather (مطلوب)
BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE

# أقل وأكثر عدد لاعبين (الأدنى المسموح تقنياً 4، والأقصى 30)
MIN_PLAYERS=5
MAX_PLAYERS=20

# معامل سرعة اللعبة: 1 = الافتراضي، 1.5 = أبطأ بنصف، 0.5 = أسرع بالنصف
TIME_SCALE=1

# مهلة التصويت الإضافية بعد أن يصوّت الجميع (ثوانٍ) — لتصحيح الأخطاء قبل إعلان الحكم
VOTE_GRACE=8

# إغلاق الردهة تلقائياً بعد (ثوانٍ) من الخمول
LOBBY_TIMEOUT=600

# تخصيص مدة مرحلة بعينها بالثواني (اختياري): ROLES PROSECUTION DEFENSE WITNESSES LAST_WORD DELIBERATION VOTING
# DUR_PROSECUTION=90
# DUR_WITNESSES=150

# مكان حفظ لوحة النقاط (الافتراضي: مجلد data بجانب البرنامج)
# DATA_DIR=/var/lib/court-bot

# مستوى السجلات: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
